<h1>Edit Center</h1>

{{#if error}}
  <p class="error">{{error}}</p>
{{/if}}

<form method="POST" action="/centers/{{center._id}}/edit">
  <label for="location_name">Location Name</label>
  <input type="text" id="location_name" name="location_name" value="{{center.location_name}}" required>

  <label for="borough_name">Borough</label>
  <input type="text" id="borough_name" name="borough_name" value="{{center.borough_name}}" required>

  <label for="address_street">Address</label>
  <input type="text" id="address_street" name="address_street" value="{{#if center.address_street}}{{center.address_street}}{{else}}{{center.full_location_address}}{{/if}}" required>

  <label for="operator_name">Operator</label>
  <input type="text" id="operator_name" name="operator_name" value="{{center.operator_name}}" required>

  <label for="type_of_device_available">Devices Available</label>
  <input type="text" id="type_of_device_available" name="type_of_device_available" value="{{center.type_of_device_available}}">

  <label for="workstation_number">Workstation Number</label>
  <input type="text" id="workstation_number" name="workstation_number" value="{{center.workstation_number}}">

  <h2>Hours</h2>

  <label for="mon_open">Monday</label>
  <input 
    type="text" 
    id="mon_open" 
    name="mon_open" 
    value="{{center.mon_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="tue_open">Tuesday</label>
  <input 
    type="text" 
    id="tue_open" 
    name="tue_open" 
    value="{{center.tue_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="wed_open">Wednesday</label>
  <input 
    type="text" 
    id="wed_open" 
    name="wed_open" 
    value="{{center.wed_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="thu_open">Thursday</label>
  <input 
    type="text" 
    id="thu_open" 
    name="thu_open" 
    value="{{center.thu_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="fri_open">Friday</label>
  <input 
    type="text" 
    id="fri_open" 
    name="fri_open" 
    value="{{center.fri_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="sat_open">Saturday</label>
  <input 
    type="text" 
    id="sat_open" 
    name="sat_open" 
    value="{{center.sat_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="sun_open">Sunday</label>
  <input 
    type="text" 
    id="sun_open" 
    name="sun_open" 
    value="{{center.sun_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <h2>Contact</h2>

  <label for="full_location_phone_number">Phone</label>
  <input 
    type="tel" 
    id="full_location_phone_number" 
    name="full_location_phone_number" 
    value="{{#if center.full_location_phone_number}}{{center.full_location_phone_number}}{{else}}N/A{{/if}}"
    placeholder="(212) 281-1349 or N/A"
    pattern="(\([0-9]{3}\) [0-9]{3}-[0-9]{4}|[0-9]{3}-[0-9]{3}-[0-9]{4}|[Nn]\/[Aa])"
    title="Use format (212) 281-1349, 212-281-1349, or N/A"
    required
  >

  <label for="website">Website</label>
  <input 
    type="text" 
    id="website" 
    name="website" 
    value="{{#if center.url.url}}{{center.url.url}}{{else}}N/A{{/if}}" 
    placeholder="https://example.com or N/A"
    pattern="(https://.*|http://.*|[Nn]\/[Aa])"
    title="Use a valid website like https://example.com, or N/A"
  >

  <h2>Accessibility</h2>

  <label for="wheelchair_accessible">Wheelchair Accessible</label>
  <select id="wheelchair_accessible" name="wheelchair_accessible">
    <option value="Y" {{#if (eq center.wheelchair_accessible "Y")}}selected{{/if}}>Yes</option>
    <option value="N" {{#if (eq center.wheelchair_accessible "N")}}selected{{/if}}>No</option>
  </select>

  <label for="assistive_technology">Assistive Technology</label>
  <select id="assistive_technology" name="assistive_technology">
    <option value="Y" {{#if (eq center.assistive_technology "Y")}}selected{{/if}}>Yes</option>
    <option value="N" {{#if (eq center.assistive_technology "N")}}selected{{/if}}>No</option>
  </select>

  <h2>Course Offerings</h2>

  <label>
  <input 
      type="checkbox" 
      name="technology_related_courses" 
      value="Y" 
      {{#if (eq center.technology_related_courses "Y")}}checked{{/if}}
    >
    Technology Related Courses
  </label>

  <label>
    <input 
      type="checkbox" 
      name="productivity_tools_ex_using" 
      value="Y" 
      {{#if (eq center.productivity_tools_ex_using "Y")}}checked{{/if}}
    >
    Productivity Tools
  </label>

  <label>
    <input 
      type="checkbox" 
      name="job_readiness_ex_resume_help" 
      value="Y" 
      {{#if (eq center.job_readiness_ex_resume_help "Y")}}checked{{/if}}
    >
    Job Readiness
  </label>

  <label>
    <input 
      type="checkbox" 
      name="education_ex_personal_growth" 
      value="Y" 
      {{#if (eq center.education_ex_personal_growth "Y")}}checked{{/if}}
    >
    Education / Personal Growth
  </label>

  <label>
    <input 
      type="checkbox" 
      name="media_and_entertainment_ex" 
      value="Y" 
      {{#if (eq center.media_and_entertainment_ex "Y")}}checked{{/if}}
    >
    Media and Entertainment
  </label>

  <label>
    <input 
      type="checkbox" 
      name="certifications_ex_in_software" 
      value="Y" 
      {{#if (eq center.certifications_ex_in_software "Y")}}checked{{/if}}
    >
    Certifications
  </label>

  <label>
    <input 
      type="checkbox" 
      name="digital_literacy" 
      value="Y" 
      {{#if (eq center.digital_literacy "Y")}}checked{{/if}}
    >
    Digital Literacy
  </label>
  
<br>
<button type="submit">Save Changes</button>
</form>

<p>
  <a href="/centers/{{center._id}}">Back to Center</a>
</p>