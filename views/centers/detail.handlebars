<div class="center-detail">
  <h1>{{center.location_name}}</h1>

  {{#if user.isAdmin}}
  <div class="admin-center-actions">
    <a href="/centers/{{center._id}}/edit">Edit Center</a>

    <form method="POST" action="/centers/{{center._id}}/delete" style="display:inline; margin-left: 10px;">
      <button type="submit" onclick="return confirm('Delete this center? This cannot be undone.');">
        Delete Center
      </button>
    </form>
  </div>
{{/if}}
  
  <div class="center-info">
    <p><strong>Address: </strong> {{center.address_street}}</p>
    <p><strong>Operator:</strong> {{center.operator_name}}</p>
    <p><strong>Devices Available:</strong> {{center.type_of_device_available}}</p>
    <p> <strong>Status:</strong> {{#if center.isOpen}} Open {{else}} Closed {{/if}} </p> 
    <p><strong>Hours:</strong></p>
    <div id="hours-div">
      <p><strong>Monday:</strong> {{#if center.mon_open}}{{center.mon_open}}{{else}}N/A{{/if}}</p>
      <p><strong>Tuesday:</strong> {{#if center.tue_open}}{{center.tue_open}}{{else}}N/A{{/if}}</p>
      <p><strong>Wednesday:</strong> {{#if center.wed_open}}{{center.wed_open}}{{else}}N/A{{/if}}</p>
      <p><strong>Thursday:</strong> {{#if center.thu_open}}{{center.thu_open}}{{else}}N/A{{/if}}</p>
      <p><strong>Friday:</strong> {{#if center.fri_open}}{{center.fri_open}}{{else}}N/A{{/if}}</p>
      <p><strong>Saturday:</strong> {{#if center.sat_open}}{{center.sat_open}}{{else}}N/A{{/if}}</p>
      <p><strong>Sunday:</strong> {{#if center.sun_open}}{{center.sun_open}}{{else}}N/A{{/if}}</p>
    </div>
  </div>

  <div class="contact-section">
      <h2>Contact</h2>
      {{#if center.full_location_phone_number}}
        <p><strong>Phone:</strong> {{center.full_location_phone_number}}</p>
      {{/if}}
      {{#if center.url.url}}
        <p><strong>Website:</strong> <a href="{{center.url.url}}" target="_blank">{{center.url.url}}</a></p>
    {{/if}}
  </div>

<div class="accessibility-section">
    <h2>Accessibility</h2>
    <p><strong>Wheelchair Accessible:</strong> {{#if (eq center.wheelchair_accessible "Y")}}Yes{{else}}No{{/if}}</p>
    <p><strong>Assistive Technology:</strong> {{#if (eq center.assistive_technology "Y")}}Yes{{else}}No{{/if}}</p>
    {{#if center.wheelchair_access_notes}}
        <p><strong>Notes:</strong> {{center.wheelchair_access_notes}}</p>
    {{/if}}
</div>

<div class="courses-section">
    <h2>Course Offerings</h2>
    <ul>
        {{#if (eq center.technology_related_courses "Y")}}<li>Technology Courses</li>{{/if}}
        {{#if (eq center.productivity_tools_ex_using "Y")}}<li>Productivity Tools</li>{{/if}}
        {{#if (eq center.job_readiness_ex_resume_help "Y")}}<li>Job Help</li>{{/if}}
        {{#if (eq center.education_ex_personal_growth "Y")}}<li>Education/Personal Growth</li>{{/if}}
        {{#if (eq center.creative_expression_ex_making "Y")}}<li>Creative Expression</li>{{/if}}
        {{#if (eq center.media_and_entertainment_ex "Y")}}<li>Media & Entertainment</li>{{/if}}
        {{#if (eq center.certifications_ex_in_software "Y")}}<li>Certifications</li>{{/if}}
        {{#if (eq center.digital_literacy "Y")}}<li>Digital Literacy</li>{{/if}}
    </ul>
</div>

  <div class="favorites-section">
    {{#if user}}
      <button id="fav-btn" data-center-id="{{center._id}}">{{#if isFavorited}}Remove from Favorites{{else}}Add to favorites{{/if}}</button>
    {{else}}
      <p><a href="/auth/login">Log in</a> to add this center to your favorites!</p>
    {{/if}}
  </div>

  <div class="reviews-section">
    <h2>Reviews</h2>

    {{#if centerReviews.length}}
      {{#each centerReviews}}
        <div class="review-card">
          <p><strong>{{this.userName}}</strong> — {{this.rating}}/5</p>
          <p>{{this.comment}}</p>
          {{#if (eq this.userId ../user._id)}}
            <form method="POST" action="/centers/{{../center._id}}/reviews/{{this._id}}/delete">
              <button type="submit">Delete</button>
            </form>
          {{/if}}
        </div>
      {{/each}}
    {{else}}
      <p>No reviews yet. Be the first!</p>
    {{/if}}

    {{#if user}}
      <h3>Leave a Review</h3>
      <form method="POST" action="/centers/{{center._id}}/reviews">
        <label>Rating (1–5):
            <select name="rating" required>
                <option value="">Select A Rating</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>
        </label>
        <label>Comment: <textarea name="comment" required></textarea></label>
        <button type="submit">Submit</button>
      </form>
      <div id="review-error">{{reviewError}}</div>
    {{else}}
      <p><a href="/auth/login">Log in</a> to leave a review.</p>
    {{/if}}
  </div>

  <div class="reports-section">
    <h2>Reports</h2>

    {{#if user}}
      <h3>Report an Issue</h3>

      <form id="report-form">
        <input type="hidden" id="center-id" value="{{center._id}}">
        <label for="issue-types">Issue Type:</label>
        <select id="issue-types" name="issueType" required>
          <option value="incorrect hours">Incorrect Hours</option>
          <option value="incorrect address">Incorrect Address</option>
          <option value="other">Other Issue</option>
        </select>

        <label for="issue">Issue:</label>
        <textarea id="issue" name="description" required></textarea>

        <button type="submit">Submit</button>
      </form>

      <div id="report-success-failure"></div>
    {{else}}
      <p><a href="/auth/login">Log in</a> to report an issue.</p>
    {{/if}}

  </div>
</div>