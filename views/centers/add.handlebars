<h1>Add Center</h1>

{{#if error}}
  <p class="error">{{error}}</p>
{{/if}}

<form method="POST" action="/centers/add">
  <label for="location_name">Location Name</label>
  <input type="text" id="location_name" name="location_name" value="{{formData.location_name}}" required>

  <label for="borough_name">Borough</label>
  <input type="text" id="borough_name" name="borough_name" value="{{formData.borough_name}}" required>

  <label for="address_street">Address</label>
  <input type="text" id="address_street" name="address_street" value="{{formData.address_street}}" required>

  <label for="operator_name">Operator</label>
  <input type="text" id="operator_name" name="operator_name" value="{{formData.operator_name}}" required>

  <label for="type_of_device_available">Devices Available</label>
  <input type="text" id="type_of_device_available" name="type_of_device_available" value="{{formData.type_of_device_available}}">

  <label for="workstation_number">Workstation Number</label>
  <input type="text" id="workstation_number" name="workstation_number" value="{{formData.workstation_number}}">

  <h2>Hours</h2>

  <label for="mon_open">Monday</label>
  <input type="text" id="mon_open" name="mon_open" value="{{formData.mon_open}}">

  <label for="tue_open">Tuesday</label>
  <input type="text" id="tue_open" name="tue_open" value="{{formData.tue_open}}">

  <label for="wed_open">Wednesday</label>
  <input type="text" id="wed_open" name="wed_open" value="{{formData.wed_open}}">

  <label for="thu_open">Thursday</label>
  <input type="text" id="thu_open" name="thu_open" value="{{formData.thu_open}}">

  <label for="fri_open">Friday</label>
  <input type="text" id="fri_open" name="fri_open" value="{{formData.fri_open}}">

  <label for="sat_open">Saturday</label>
  <input type="text" id="sat_open" name="sat_open" value="{{formData.sat_open}}">

  <label for="sun_open">Sunday</label>
  <input type="text" id="sun_open" name="sun_open" value="{{formData.sun_open}}">

  <button type="submit">Add Center</button>
</form>

<p>
  <a href="/admin">Back to Admin Dashboard</a>
</p>