<h1>Add Center</h1>

{{#if error}}
  <p class="error">{{error}}</p>
{{/if}}

<form method="POST" action="/centers/add">

  <label for="location_name">Location Name</label>
  <input 
    type="text" 
    id="location_name" 
    name="location_name" 
    value="{{formData.location_name}}" 
    required
  >

  <label for="borough_name">Borough</label>
  <input 
    type="text" 
    id="borough_name" 
    name="borough_name" 
    value="{{formData.borough_name}}" 
    required
  >

  <label for="address_street">Address</label>
  <input 
    type="text" 
    id="address_street" 
    name="address_street" 
    value="{{formData.address_street}}" 
    required
  >

  <label for="operator_name">Operator</label>
  <input 
    type="text" 
    id="operator_name" 
    name="operator_name" 
    value="{{formData.operator_name}}" 
    required
  >

  <label for="type_of_device_available">Devices Available</label>
  <input 
    type="text" 
    id="type_of_device_available" 
    name="type_of_device_available" 
    value="{{formData.type_of_device_available}}"
  >

  <label for="workstation_number">Workstation Number</label>
  <input 
    type="text" 
    id="workstation_number" 
    name="workstation_number" 
    value="{{formData.workstation_number}}"
  >

  <h2>Hours</h2>

  <label for="mon_open">Monday</label>
  <input 
    type="text"
    id="mon_open"
    name="mon_open"
    value="{{formData.mon_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="tue_open">Tuesday</label>
  <input 
    type="text"
    id="tue_open"
    name="tue_open"
    value="{{formData.tue_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="wed_open">Wednesday</label>
  <input 
    type="text"
    id="wed_open"
    name="wed_open"
    value="{{formData.wed_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="thu_open">Thursday</label>
  <input 
    type="text"
    id="thu_open"
    name="thu_open"
    value="{{formData.thu_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="fri_open">Friday</label>
  <input 
    type="text"
    id="fri_open"
    name="fri_open"
    value="{{formData.fri_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="sat_open">Saturday</label>
  <input 
    type="text"
    id="sat_open"
    name="sat_open"
    value="{{formData.sat_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <label for="sun_open">Sunday</label>
  <input 
    type="text"
    id="sun_open"
    name="sun_open"
    value="{{formData.sun_open}}"
    placeholder="8:00 AM - 4:00 PM, Closed, or Unavailable"
    pattern="^((0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm]) - (0?[1-9]|1[0-2]):[0-5][0-9] ([AaPp][Mm])|[Cc][Ll][Oo][Ss][Ee][Dd]|[Uu][Nn][Aa][Vv][Aa][Ii][Ll][Aa][Bb][Ll][Ee])$"
    title="Use format like 8:00 AM - 4:00 PM, Closed, or Unavailable"
  >

  <h2>Contact</h2>

  <label for="full_location_phone_number">Phone</label>
  <input 
    type="tel"
    id="full_location_phone_number"
    name="full_location_phone_number"
    value="{{formData.full_location_phone_number}}"
    placeholder="(212) 281-1349 or N/A"
    pattern="(\([0-9]{3}\) [0-9]{3}-[0-9]{4}|[0-9]{3}-[0-9]{3}-[0-9]{4}|[Nn]\/[Aa])"
    title="Use format (212) 281-1349, 212-281-1349, or N/A"
  >

  <label for="website">Website</label>
  <input 
    type="text"
    id="website"
    name="website"
    value="{{formData.website}}"
    placeholder="https://example.com or N/A"
    pattern="(https://.*|http://.*|[Nn]\/[Aa])"
    title="Use a valid website like https://example.com or N/A"
  >

  <h2>Accessibility</h2>

  <label for="wheelchair_accessible">Wheelchair Accessible</label>
  <select id="wheelchair_accessible" name="wheelchair_accessible">
    <option value="Y">Yes</option>
    <option value="N">No</option>
  </select>

  <label for="assistive_technology">Assistive Technology</label>
  <select id="assistive_technology" name="assistive_technology">
    <option value="Y">Yes</option>
    <option value="N">No</option>
  </select>

  <h2>Course Offerings</h2>

  <label><input type="checkbox" name="technology_related_courses" value="Y"> Technology Related Courses</label>

  <label><input type="checkbox" name="productivity_tools_ex_using" value="Y"> Productivity Tools</label>

  <label><input type="checkbox" name="job_readiness_ex_resume_help" value="Y"> Job Readiness</label>

  <label><input type="checkbox" name="education_ex_personal_growth" value="Y"> Education / Personal Growth</label>

  <label><input type="checkbox" name="media_and_entertainment_ex" value="Y"> Media and Entertainment</label>

  <label><input type="checkbox" name="certifications_ex_in_software" value="Y"> Certifications</label>

  <label><input type="checkbox" name="digital_literacy" value="Y"> Digital Literacy</label>

  <br>

  <button type="submit">Add Center</button>
</form>

<p>
  <a href="/admin">Back to Admin Dashboard</a>
</p>